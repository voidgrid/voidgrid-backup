# voidgrid-backup-server example configuration.
# Copy to .env next to docker-compose.yaml and adjust. Docker Compose reads it
# for the ${...} values in the compose file and passes it to the container.

# Image to run. `voidgrid-backup:latest` here assumes you built it yourself
# (`docker build -t voidgrid-backup:latest .` from the repo). Point this at
# a registry instead once you publish builds somewhere (a commit SHA tag
# is safer to pin than :latest).
VB_IMAGE=voidgrid-backup:latest

# Time zone for job schedules (cron expressions are evaluated in it) and the
# times shown in the UI. Any IANA name, e.g. Europe/Berlin or America/Chicago.
TZ=UTC

# Host port the web UI and API are published on.
VB_PORT=8080

# Port agents register on (TLS). The same number is used inside the container
# and on the host. Defaults to 9442. Agents need to reach it; the web UI port
# is not used for this and can stay behind a reverse proxy.
VB_AGENT_PORT=9442

# User the server runs as -- 1000:1000, the usual first non-root user on a
# Linux host, so ./data often needs no chown at all if you're running this
# as yourself. If it does: mkdir -p data && sudo chown 1000:1000 data
# (use your own uid/gid, `id -u`/`id -g`, if you set these to something else).
VB_UID=1000
VB_GID=1000

# How often the server checks that every agent is reachable.
VB_POLL=30s

# Optional: sign in via OIDC (any provider - Authelia, Authentik, Keycloak,
# Google, etc) as well as a recovery code. Signing in is required either
# way -- leaving VB_OIDC_ISSUER empty means a recovery code is the only way
# in, not that login is off; see docs/server.md#authentication and visit
# /setup on first start regardless of this setting.
#VB_OIDC_ISSUER=https://auth.example.com
#VB_OIDC_CLIENT_ID=voidgrid-backup
#VB_OIDC_CLIENT_SECRET=changeme
#VB_OIDC_REDIRECT_URL=https://backup.example.com/auth/callback
# Comma-separated; empty allows any identity the provider authenticates.
#VB_OIDC_ALLOWED_EMAILS=you@example.com
