# voidgrid-backup-agent example configuration.
# Copy to .env next to docker-compose.yaml and adjust. Docker Compose reads it
# for the ${...} values in the compose file and passes it to the container.

# Image to run. Same image as the server (see its .env.example) -- just run
# with a different entrypoint, which docker-compose.yaml here already sets.
VB_IMAGE=voidgrid-backup:latest

TZ=UTC

# Name shown in the server UI and recorded on every snapshot. Keep it stable:
# snapshots are grouped by it, and browsing/restoring only works from the
# agent with the same name.
VB_HOSTNAME=myhost

# Host port the server connects to (gRPC over mutual TLS).
VB_PORT=9443

# Sockets on the host. Leave a line's value empty and remove its volume in
# docker-compose.yaml to turn that feature off.
DOCKER_SOCKET=/var/run/docker.sock
LIBVIRT_SOCKET=/var/run/libvirt/libvirt-sock

# Host directories the agent may back up. Each is mounted at the SAME path
# inside the agent (Docker and libvirt report host paths) and read-only:
# read-only paths can be backed up but only restored to another directory.
STACKS_DIR=/srv/stacks
DATA_DIR=/srv/data
VM_IMAGES_DIR=/var/lib/libvirt/images

# Writable host directory for restores ("restore to directory" targets).
RESTORE_DIR=/srv/restore

# Private key for an SFTP repository (e.g. a Hetzner Storage Box). In the
# repository form, use the path it has inside the agent: /keys/sftp_key
SFTP_KEY=/root/.ssh/id_ecdsa
